<Window x:Class="WinCleaner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinCleaner.Views"
        xmlns:vm="clr-namespace:WinCleaner.ViewModels"
        xmlns:models="clr-namespace:WinCleaner.Models"
        mc:Ignorable="d"
        Title="WinCleaner - Professional System Cleaner"
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource DefaultFont}">

    <Window.Resources>
        <models:BytesToStringConverter x:Key="BytesToStringConverter"/>
        <models:CleanProfileToStringConverter x:Key="ProfileToStringConverter"/>
        <models:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>     <!-- Header -->
            <RowDefinition Height="Auto"/>     <!-- Toolbar -->
            <RowDefinition Height="*"/>        <!-- Main Content -->
            <RowDefinition Height="Auto"/>     <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="🧹" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WinCleaner" FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Professional System Cleaner for Windows" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Style="{StaticResource DriveInfoCard}" Margin="0,0,16,0" DataContext="{Binding Drives[0]}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="16" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeNormal}"/>
                                <TextBlock>
                                    <Run Text="{Binding UsedSpaceFormatted, Mode=OneWay}"/> / <Run Text="{Binding TotalSizeFormatted, Mode=OneWay}"/>
                                    <Run Text=" ("/><Run Text="{Binding UsedPercent, StringFormat='{}{0:0.#}%', Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshDrivesCommand}" ToolTip="Làm mới ổ đĩa" Padding="8">
                        <TextBlock Text="🔄" FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding OpenSettingsCommand}" ToolTip="Cài đặt" Padding="8">
                        <TextBlock Text="⚙" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Profile Selector -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Profile:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox Width="200" 
                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              ItemsSource="{Binding Source={x:Static models:CleanProfile.Safe}, Converter={x:Static models:EnumToCollectionConverter.Instance}}"
                              ItemTemplate="{StaticResource ProfileComboBoxTemplate}"
                              Style="{StaticResource ModernComboBox}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search/Filter -->
                <TextBox Grid.Column="1" 
                         Width="300" 
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                         Style="{StaticResource SearchTextBox}"
                         Tag="🔍 Tìm kiếm mục cần dọn..."/>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectSafeCommand}" ToolTip="Chọn các mục an toàn (Safe/Low risk)">
                        <TextBlock><Run Text="✓ "/><Run Text="An toàn"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectAllCommand}" ToolTip="Chọn tất cả">
                        <TextBlock><Run Text="☐ "/><Run Text="Tất cả"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeselectAllCommand}" ToolTip="Bỏ chọn tất cả">
                        <TextBlock><Run Text="☑ "/><Run Text="Bỏ tất cả"/></TextBlock>
                    </Button>
                    <CheckBox Content="Dry Run" IsChecked="{Binding DryRunMode, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="16,0,8,0" ToolTip="Chỉ mô phỏng, không xóa thực tế"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ScanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibilityConverter}, ConverterParameter=not}" Padding="16,8" MinWidth="100">
                        <TextBlock><Run Text="🔍 "/><Run Text="Quét"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding CleanCommand}" IsEnabled="{Binding IsCleaning, Converter={StaticResource InverseBoolToVisibilityConverter}, ConverterParameter=not}" Padding="16,8" MinWidth="120">
                        <TextBlock><Run Text="🧹 "/><Run Text="Dọn dẹp"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}" IsEnabled="{Binding IsScanning}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" Padding="16,8">
                        <TextBlock><Run Text="✕ "/><Run Text="Hủy"/></TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Clean Items Tree/List -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Mục có thể dọn dẹp" FontSize="{StaticResource FontSizeMedium}" FontWeight="SemiBold" Margin="8,8,8,4"/>

                    <TreeView Grid.Row="1" 
                              ItemsSource="{Binding CleanGroups}"
                              ItemContainerStyle="{StaticResource CategoryTreeViewItem}"
                              BorderThickness="0"
                              Background="Transparent"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                                <!-- Category Header is handled by CategoryTreeViewItem style -->
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:CleanItem}">
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center"/>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Text=" (" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SizeFormatted}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" FontFamily="{StaticResource MonospaceFont}" VerticalAlignment="Center"/>
                                        <TextBlock Text=")" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding Status}" 
                                               Foreground="{Binding Status, Converter={StaticResource CleanStatusToBrushConverter}}"
                                               FontSize="{StaticResource FontSizeSmall}" 
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Margin="12,0"/>
                                    
                                    <Border Grid.Column="3" 
                                            Background="{Binding RiskLevel, Converter={StaticResource RiskLevelToBrushConverter}}" 
                                            CornerRadius="10" 
                                            Padding="6,2" 
                                            Margin="8,0"
                                            VerticalAlignment="Center"
                                            ToolTip="{Binding RiskLevel, Converter={StaticResource RiskLevelToTooltipConverter}}">
                                        <TextBlock Text="{Binding RiskLevel}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    
                                    <ProgressBar Grid.Column="4" 
                                                 Width="80" Height="4" 
                                                 Value="{Binding ProgressPercent}" 
                                                 Maximum="100"
                                                 Style="{StaticResource ModernProgressBar}"
                                                 Visibility="{Binding Status, Converter={StaticResource CleanStatusToVisibilityConverter}}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- Right Panel: Log Console -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Console Log" FontSize="{StaticResource FontSizeMedium}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox Content="Tự cuộn" IsChecked="{Binding AutoScrollLog, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding ClearLogCommand}" ToolTip="Xóa log" Padding="6">
                                <TextBlock Text="🗑" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding ExportLogCommand}" ToolTip="Xuất log" Padding="6">
                                <TextBlock Text="💾" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                        <ItemsControl ItemsSource="{Binding LogEntries}" VirtualizingPanel.IsVirtualizing="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,1" Padding="6,2" Background="{Binding Level, Converter={StaticResource LogLevelToBackgroundConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FormattedTime}" FontFamily="{StaticResource MonospaceFont}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" Margin="8,0" Width="60"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="{StaticResource MonospaceFont}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ProgressBar Grid.Row="2" Height="3" Value="{Binding OverallProgress}" Maximum="100" Style="{StaticResource ModernProgressBar}" Margin="0,0,0,4" Foreground="{StaticResource PrimaryBrush}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="Mục: " Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalItems}" FontWeight="SemiBold"/>
                    <TextBlock Text=" | Đã chọn: " Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding SelectedItems}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text=" | Dung lượng: " Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalSelectedSize, Converter={StaticResource BytesToStringConverter}}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding ScanProgressText}" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="User: " Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding SystemInfo.CurrentUser}" FontWeight="SemiBold"/>
                    <TextBlock Text=" | " Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding SystemInfo.IsAdmin, Converter={StaticResource BoolToAdminTextConverter}}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>