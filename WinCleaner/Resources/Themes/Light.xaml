<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:models="clr-namespace:WinCleaner.Models">

    <!-- Light Theme Colors -->
    <Color x:Key="PrimaryColor">#0078D4</Color>
    <Color x:Key="PrimaryDarkColor">#005A9E</Color>
    <Color x:Key="PrimaryLightColor">#409CFF</Color>
    <Color x:Key="SecondaryColor">#605E5C</Color>
    <Color x:Key="SuccessColor">#107C10</Color>
    <Color x:Key="WarningColor">#FF8C00</Color>
    <Color x:Key="ErrorColor">#D13438</Color>
    <Color x:Key="BackgroundColor">#F3F2F1</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#D2D0CE</Color>
    <Color x:Key="TextPrimaryColor">#323130</Color>
    <Color x:Key="TextSecondaryColor">#605E5C</Color>
    <Color x:Key="TextDisabledColor">#A19F9D</Color>
    <Color x:Key="HoverColor">#E8E6E4</Color>
    <Color x:Key="PressedColor">#D2D0CE</Color>
    <Color x:Key="FocusColor">#0078D4</Color>
    <Color x:Key="RiskSafeColor">#107C10</Color>
    <Color x:Key="RiskLowColor">#0078D4</Color>
    <Color x:Key="RiskMediumColor">#FF8C00</Color>
    <Color x:Key="RiskHighColor">#D13438</Color>
    <Color x:Key="RiskCriticalColor">#8B0000</Color>
    <Color x:Key="ScrollBarColor">#CCCCCC</Color>
    <Color x:Key="ScrollBarHoverColor">#AAAAAA</Color>
    <Color x:Key="TreeViewBackground">#FFFFFF</Color>
    <Color x:Key="TreeViewBorder">#E8E6E4</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}"/>
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}"/>
    <SolidColorBrush x:Key="RiskSafeBrush" Color="{StaticResource RiskSafeColor}"/>
    <SolidColorBrush x:Key="RiskLowBrush" Color="{StaticResource RiskLowColor}"/>
    <SolidColorBrush x:Key="RiskMediumBrush" Color="{StaticResource RiskMediumColor}"/>
    <SolidColorBrush x:Key="RiskHighBrush" Color="{StaticResource RiskHighColor}"/>
    <SolidColorBrush x:Key="RiskCriticalBrush" Color="{StaticResource RiskCriticalColor}"/>
    <SolidColorBrush x:Key="ScrollBarBrush" Color="{StaticResource ScrollBarColor}"/>
    <SolidColorBrush x:Key="ScrollBarHoverBrush" Color="{StaticResource ScrollBarHoverColor}"/>
    <SolidColorBrush x:Key="TreeViewBackgroundBrush" Color="{StaticResource TreeViewBackground}"/>
    <SolidColorBrush x:Key="TreeViewBorderBrush" Color="{StaticResource TreeViewBorder}"/>

    <!-- Fonts -->
    <FontFamily x:Key="DefaultFont">Segoe UI Variable, Segoe UI, Sans-Serif</FontFamily>
    <FontFamily x:Key="MonospaceFont">Cascadia Code, Consolas, Monospace</FontFamily>

    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeNormal">13</sys:Double>
    <sys:Double x:Key="FontSizeMedium">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeXLarge">20</sys:Double>
    <sys:Double x:Key="FontSizeTitle">28</sys:Double>

    <!-- Spacing -->
    <Thickness x:Key="MarginSmall">4</Thickness>
    <Thickness x:Key="MarginNormal">8</Thickness>
    <Thickness x:Key="MarginMedium">12</Thickness>
    <Thickness x:Key="MarginLarge">16</Thickness>
    <Thickness x:Key="MarginXLarge">24</Thickness>
    <Thickness x:Key="PaddingSmall">4</Thickness>
    <Thickness x:Key="PaddingNormal">8</Thickness>
    <Thickness x:Key="PaddingMedium">12</Thickness>
    <Thickness x:Key="PaddingLarge">16</Thickness>

    <CornerRadius x:Key="CornerRadiusSmall">2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusNormal">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">8</CornerRadius>

    <!-- Shadows -->
    <DropShadowEffect x:Key="ShadowSmall" BlurRadius="4" ShadowDepth="1" Opacity="0.1" Color="Black"/>
    <DropShadowEffect x:Key="ShadowMedium" BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="Black"/>
    <DropShadowEffect x:Key="ShadowLarge" BlurRadius="16" ShadowDepth="4" Opacity="0.2" Color="Black"/>

</ResourceDictionary>