<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinCleaner.Core\WinCleaner.Core.csproj" />
    <ProjectReference Include="..\..\src\WinCleaner.Infrastructure.Windows\WinCleaner.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\..\WinCleaner-classic\WinCleaner.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyClassicAssembly" AfterTargets="Build">
    <Copy SourceFiles="..\..\WinCleaner-classic\bin\Release\net8.0-windows\win-x64\WinCleaner.dll" DestinationFolder="$(OutputPath)" Condition="Exists('..\..\WinCleaner-classic\bin\Release\net8.0-windows\win-x64\WinCleaner.dll')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>
</Project>