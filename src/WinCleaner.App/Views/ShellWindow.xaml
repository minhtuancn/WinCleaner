<Window x:Class="WinCleaner.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinCleaner.Views"
        xmlns:vm="clr-namespace:WinCleaner.ViewModels"
        xmlns:design="clr-namespace:WinCleaner.Design"
        mc:Ignorable="d"
        Title="WinCleaner - Professional System Cleaner"
        Height="850" Width="1300"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Converters.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" 
                Background="{DynamicResource SurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Header -->
                <Border Grid.Row="0" Padding="{StaticResource SpacingMd}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource PrimaryBrush}">
                            <Path Data="{x:Static design:Icons.Broom}" Fill="{DynamicResource TextOnPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WinCleaner" FontSize="{StaticResource FontSizeLarge}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Professional System Cleaner" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="{StaticResource SpacingSm}">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButtonStyle}" 
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding ViewName}"
                                        ToolTip="{Binding Description}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{Binding Icon}" Fill="{DynamicResource TextSecondaryBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeMedium}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Bottom Actions -->
                <Border Grid.Row="2" Padding="{StaticResource SpacingMd}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleThemeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{x:Static design:Icons.Settings}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Toggle Theme" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportDiagnosticsCommand}" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{x:Static design:Icons.Download}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Export Diagnostics" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>

        <!-- Sidebar Toggle (for narrow widths) -->
        <Button Grid.Column="0" Grid.ColumnSpan="2" 
                Style="{StaticResource FloatingButtonStyle}"
                Command="{Binding ToggleSidebarCommand}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="{StaticResource SpacingMd}"
                Width="40" Height="40"
                ToolTip="Toggle Sidebar">
            <Path Data="{x:Static design:Icons.ChevronLeft}" Fill="{DynamicResource TextPrimaryBrush}" Width="20" Height="20" Stretch="Uniform"/>
        </Button>
    </Grid>
</Window>