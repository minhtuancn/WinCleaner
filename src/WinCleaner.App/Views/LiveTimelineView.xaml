<UserControl x:Class="WinCleaner.Views.LiveTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WinCleaner.ViewModels"
             xmlns:design="clr-namespace:WinCleaner.Design"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LiveTimelineViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <Style x:Key="EventTypeColorStyle" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="Success">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Info">
                    <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Cancel">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Debug">
                    <Setter Property="Background" Value="{DynamicResource TextDisabledBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: Status + Controls -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Current Stage -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="Trạng thái" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextDisabledBrush}"/>
                    <TextBlock Text="{Binding CurrentStage}" FontSize="{StaticResource FontSizeLarge}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- Progress + Stats -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Margin="24,0,0,0">
<Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,16 ,0" MinWidth="160">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{x:Static design:Icons.Clock}" Fill="{DynamicResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Thời gian" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextDisabledBrush}"/>
                                    <TextBlock Text="{Binding ElapsedFormatted}" FontSize="{StaticResource FontSizeMedium}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

<Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,16 ,0" MinWidth="140">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{x:Static design:Icons.File}" Fill="{DynamicResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mục tìm thấy" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextDisabledBrush}"/>
                                    <TextBlock Text="{Binding ItemsFound, StringFormat='{}{0:N0} '}" FontSize="{StaticResource FontSizeMedium}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

<Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,16 ,0" MinWidth="160">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{x:Static design:Icons.Database}" Fill="{DynamicResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Dung lượng" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextDisabledBrush}"/>
                                    <TextBlock Text="{Binding TotalSizeFormatted}" FontSize="{StaticResource FontSizeMedium}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16" MinWidth="120">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{x:Static design:Icons.AlertTriangle}" Fill="{DynamicResource WarningBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Cảnh báo" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextDisabledBrush}"/>
                                <TextBlock Text="{Binding WarningsCount}" FontSize="{StaticResource FontSizeMedium}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Progress + Actions -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Margin="24,0,0,0">
                    <ProgressBar Width="200" Height="8" Value="{Binding ProgressPercent}" Maximum="100" 
                                 Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource PrimaryBrush}" 
                                 BorderThickness="0" VerticalAlignment="Center" Margin="0,0,16,0"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding StartScanCommand}" 
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            Padding="16,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{x:Static design:Icons.Search}" Fill="{DynamicResource TextOnPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Quét" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding CancelCommand}" 
                            IsEnabled="{Binding CanCancel}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{x:Static design:Icons.X}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Hủy" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress Bar (full width) -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,24" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tiến trình" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding ProgressPercent, StringFormat='{}{0:F1}% '}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar Height="6" Value="{Binding ProgressPercent}" Maximum="100" 
                             Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource PrimaryBrush}" 
                             BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Events Timeline -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Nhật ký hoạt động" FontSize="{StaticResource FontSizeMedium}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="2" Width="140" Margin="8 ,0,0,0" 
                              ItemsSource="{Binding EventTypeFilterOptions}" 
                              SelectedIndex="0"
                              ToolTip="Lọc theo loại sự kiện"/>
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding Events}" 
                          Background="Transparent" BorderThickness="0" 
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="border" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EventTypeColorStyle}" CornerRadius="4" Padding="10,8" Margin="0,2" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{Binding Type, Converter={StaticResource EventTypeToIconConverter}}" 
                                          Fill="{DynamicResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Source}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Medium" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
