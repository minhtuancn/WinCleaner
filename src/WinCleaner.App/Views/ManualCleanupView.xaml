<UserControl x:Class="WinCleaner.Views.ManualCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WinCleaner.ViewModels"
             xmlns:design="clr-namespace:WinCleaner.Design"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ManualCleanupViewModel, IsDesignTimeCreatable=False}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource PaddingLg}">
        <StackPanel>

            <!-- Header -->
            <Border Style="{StaticResource CardStyle}" Padding="{StaticResource PaddingLg}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Manual Cleanup" FontSize="{StaticResource FontSizeXLarge}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Explore &amp; clean custom paths" FontSize="{StaticResource FontSizeMedium}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBox Width="300" Text="{Binding CustomPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Tag="Enter folder path..." VerticalAlignment="Center" Margin="0,0,12,0"
                         AutomationProperties.Name="Custom Path" AutomationProperties.HelpText="Enter a folder path to add for manual cleanup"/>
                    </Border>

                    <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCustomPathAsyncCommand}" Padding="24,12" MinWidth="140" VerticalAlignment="Center"
                         AutomationProperties.Name="Add Path" AutomationProperties.HelpText="Add the entered folder path for manual cleanup">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{x:Static design:Icons.Plus}" Fill="{DynamicResource TextOnPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add Path" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Tree View -->
            <Border Style="{StaticResource CardStyle}" Padding="{StaticResource PaddingLg}" Margin="0,0,0,24" Visibility="{Binding RootNodes.Count, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Folders" FontSize="{StaticResource FontSizeMedium}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <TreeView ItemsSource="{Binding RootNodes}" Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="Folder Tree" AutomationProperties.HelpText="Navigate and select folders for manual cleanup">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Expander x:Name="expander" Grid.Column="0" IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" VerticalAlignment="Center"
                                                     AutomationProperties.Name="Expand Folder" AutomationProperties.HelpText="Expand or collapse this folder"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{Binding SafetyLevel, Converter={StaticResource SafetyLevelToIconConverter}}" Fill="{Binding SafetyLevel, Converter={StaticResource SafetyLevelToBrushConverter}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeFormatted}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="expander" Property="LayoutTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding SafetyLevel, Converter={StaticResource SafetyLevelToIconConverter}}" Fill="{Binding SafetyLevel, Converter={StaticResource SafetyLevelToBrushConverter}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SizeFormatted}" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    <Border Background="{Binding SafetyLevel, Converter={StaticResource SafetyLevelToBrushConverter}}" CornerRadius="2" Padding="4,1" Margin="8,0,0,0" Visibility="{Binding SafetyLevel, Converter={StaticResource SafetyLevelToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SafetyLevel}" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </StackPanel>
            </Border>

            <!-- Node Detail -->
            <Border Style="{StaticResource CardStyle}" Padding="{StaticResource PaddingLg}" Margin="0,0,0,24" Visibility="{Binding NodeDetail, Converter={StaticResource NotNullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Details" FontSize="{StaticResource FontSizeMedium}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NodeDetail.Name}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Path:" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NodeDetail.Path}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,8" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Size:" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NodeDetail.SizeFormatted}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Safety:" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                        <Border Grid.Row="3" Grid.Column="1" Padding="6,2" CornerRadius="4" Background="{Binding NodeDetail.SafetyLevel, Converter={StaticResource SafetyLevelToBrushConverter}}" Margin="8,0,0,8" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding NodeDetail.SafetyLevel}" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Items:" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding NodeDetail.ItemCount, StringFormat='{}{0} items'}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding NodeDetail.RunningProcesses}" Visibility="{Binding NodeDetail.RunningProcesses.Count, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,2" CornerRadius="4" Background="{DynamicResource WarningBrush}" Margin="0,0,8,4">
                                    <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenInExplorerCommand}" CommandParameter="{Binding NodeDetail.Path}" Padding="16,8"
                         AutomationProperties.Name="Open in Explorer" AutomationProperties.HelpText="Open the selected folder in Windows Explorer">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{x:Static design:Icons.Folder}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open in Explorer" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
