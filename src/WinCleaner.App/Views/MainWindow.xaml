<Window x:Class="WinCleaner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinCleaner.Views"
        xmlns:vm="clr-namespace:WinCleaner.ViewModels"
        xmlns:models="clr-namespace:WinCleaner.Models;assembly=WinCleaner.Core"
        xmlns:converters="clr-namespace:WinCleaner.Models;assembly=WinCleaner.Infrastructure.Windows"
        mc:Ignorable="d"
        Title="WinCleaner - Professional System Cleaner"
        Height="850" Width="1300"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource DefaultFont}"
        FontSize="{StaticResource FontSizeNormal}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <converters:BytesToStringConverter x:Key="BytesToStringConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:CleanProfileToStringConverter x:Key="CleanProfileToStringConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>     <!-- Header with System Info -->
            <RowDefinition Height="Auto"/>     <!-- Toolbar -->
            <RowDefinition Height="*"/>        <!-- Main Content -->
            <RowDefinition Height="Auto"/>     <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: App Title + System Info Cards -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="6" Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="🧹" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WinCleaner" FontSize="{StaticResource FontSizeXLarge}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Professional System Cleaner for Windows" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- System Info Cards (Center) -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding SystemInfoCards}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InfoCardStyle}" Margin="0,0,12,0" Width="200">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Value}" FontSize="{StaticResource FontSizeNormal}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource MonospaceFont}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Date/Time + Actions (Right) -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,4">
                        <StackPanel Orientation="Vertical" Margin="0,0,16,0" HorizontalAlignment="Right">
                            <TextBlock x:Name="DateTimeText" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource MonospaceFont}"/>
                            <TextBlock Text="{Binding SystemInfo.OSVersion}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextDisabledBrush}"/>
                        </StackPanel>
                        <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshDrivesCommand}" ToolTip="Làm mới ổ đĩa" Padding="6">
                            <TextBlock Text="🔄" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding OpenSettingsCommand}" ToolTip="Cài đặt (Ctrl+,)" Padding="6">
                            <TextBlock Text="⚙" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Drive Info Bar -->
                <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusNormal}" Margin="0,8,0,0" Padding="8">
                    <ItemsControl ItemsSource="{Binding Drives}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DriveInfoCardCompact}" Margin="0,0,8,0" MinWidth="180">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="💾" FontSize="14" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                                            <TextBlock FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource MonospaceFont}">
                                                <Run Text="{Binding UsedSpaceFormatted, Mode=OneWay}"/> / <Run Text="{Binding TotalSizeFormatted, Mode=OneWay}"/>
                                                <Run Text=" ("/><Run Text="{Binding UsedPercent, Mode=OneWay, StringFormat='{}{0:0.#}%'}"/><Run Text=")"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <ProgressBar Grid.Column="2" Width="60" Height="4" Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Style="{StaticResource ModernProgressBar}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                     Foreground="{Binding UsedPercent, Mode=OneWay, Converter={StaticResource DriveUsageToBrushConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== TOOLBAR ==================== -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Profile Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Profile:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium"/>
                    <ComboBox Width="180" 
                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding AvailableProfiles}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource ModernComboBox}"
                              VerticalAlignment="Center"
                              ToolTip="Chọn cấu hình dọn dép"/>
                </StackPanel>

                <!-- Search/Filter -->
                <TextBox Grid.Column="1" 
                         Width="350" 
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         Style="{StaticResource SearchTextBox}"
                         Tag="🔍 Tìm kiếm mục cần dọn..."/>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectSafeCommand}" ToolTip="Chọn các mục an toàn (Safe/Low risk)" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="An toàn"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectAllCommand}" ToolTip="Chọn tất cả" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☐" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="Tất cả"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeselectAllCommand}" ToolTip="Bỏ chọn tất cả" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☑" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="Bỏ tất cả"/>
                        </StackPanel>
                    </Button>
                    <CheckBox Content="Dry Run" IsChecked="{Binding DryRunMode, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="12,0,8,0" ToolTip="Chỉ mô phỏng, không xóa thực tế"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ScanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibilityConverter}, ConverterParameter=not}" Padding="14,6" MinWidth="90">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="Quét"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding CleanCommand}" IsEnabled="{Binding IsCleaning, Converter={StaticResource InverseBoolToVisibilityConverter}, ConverterParameter=not}" Padding="14,6" MinWidth="110">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="Dọn dẹp"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}" IsEnabled="{Binding IsScanning}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="Hủy"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT ==================== -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Clean Items (TreeView with System/App groups) -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="8,8,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mục có thể dọn dẹp" FontSize="{StaticResource FontSizeMedium}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding ExpandAllCommand}" ToolTip="Mở rộng tất cả" Padding="6">
                                <TextBlock Text="⤢" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding CollapseAllCommand}" ToolTip="Thu gọn tất cả" Padding="6" Margin="4,0,0,0">
                                <TextBlock Text="⤡" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TreeView Grid.Row="1" 
                              ItemsSource="{Binding CleanGroups}"
                              ItemContainerStyle="{StaticResource CategoryTreeViewItem}"
                              BorderThickness="0"
                              Background="Transparent"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                                <!-- Category Header is handled by CategoryTreeViewItem style -->
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:CleanItem}">
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" ToolTip="{Binding Description}"/>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="{StaticResource FontSizeNormal}"/>
                                        <TextBlock Text=" (" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SizeFormatted}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" FontFamily="{StaticResource MonospaceFont}" VerticalAlignment="Center"/>
                                        <TextBlock Text=")" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding Status}" 
                                               Foreground="{Binding Status, Converter={StaticResource CleanStatusToBrushConverter}}"
                                               FontSize="{StaticResource FontSizeSmall}" 
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Margin="10,0"/>
                                    
                                    <Border Grid.Column="3" 
                                            Background="{Binding RiskLevel, Converter={StaticResource RiskLevelToBrushConverter}}" 
                                            CornerRadius="8" 
                                            Padding="4,1" 
                                            Margin="6,0"
                                            VerticalAlignment="Center"
                                            ToolTip="{Binding RiskLevel, Converter={StaticResource RiskLevelToTooltipConverter}}">
                                        <TextBlock Text="{Binding RiskLevel}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    
                                    <ProgressBar Grid.Column="4" 
                                                 Width="70" Height="3" 
                                                 Value="{Binding ProgressPercent}" 
                                                 Maximum="100"
                                                 Style="{StaticResource ModernProgressBar}"
                                                 Visibility="{Binding Status, Converter={StaticResource CleanStatusToVisibilityConverter}}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,6,0"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <!-- Right Panel: Details + Log Console -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusMedium}" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tab Control for Details/Log -->
                    <TabControl Grid.Row="0" Grid.RowSpan="3" BorderThickness="0" Background="Transparent" Padding="0">
                        <TabItem Header="Chi tiết" Style="{StaticResource ModernTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                                <StackPanel>
                                    <!-- Selected Item Details -->
                                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="{StaticResource CornerRadiusNormal}" Padding="12" Margin="0,0,0,10" Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="Thông tin mục đã chọn" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.Name}" FontWeight="Medium" Margin="8,2,0,2"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Đường dẫn:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.Path}" FontFamily="{StaticResource MonospaceFont}" TextWrapping="Wrap" Margin="8,2,0,2"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Dung lượng:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.SizeFormatted}" FontWeight="Medium" Foreground="{StaticResource PrimaryBrush}" FontFamily="{StaticResource MonospaceFont}" Margin="8,2,0,2"/>
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Mức rủi ro:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                                <Border Grid.Row="3" Grid.Column="1" Background="{Binding SelectedItem.RiskLevel, Converter={StaticResource RiskLevelToBrushConverter}}" CornerRadius="4" Padding="4,1" Margin="8,2,0,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding SelectedItem.RiskLevel}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Mô tả:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.Description}" TextWrapping="Wrap" Margin="8,2,0,2"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Custom Folders Section -->
                                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="{StaticResource CornerRadiusNormal}" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Thư mục tùy chỉnh" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                                                <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding AddCustomFolderCommand}" ToolTip="Thêm thư mục" Padding="6" HorizontalAlignment="Right">
                                                    <TextBlock Text="+"/>
                                                </Button>
                                            </Grid>
                                            <ListBox ItemsSource="{Binding CustomFolders}" BorderThickness="0" Background="Transparent" MaxHeight="150" Style="{StaticResource ModernListBox}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusNormal}" Padding="8" Margin="0,2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonospaceFont}" FontSize="{StaticResource FontSizeSmall}"/>
                                                                    <TextBlock Text="{Binding SizeFormatted}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" FontFamily="{StaticResource MonospaceFont}"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Command="{Binding DataContext.RemoveCustomFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Xóa" Padding="4" Margin="8,0,0,0">
                                                                    <TextBlock Text="🗑" FontSize="11"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>

                                    <!-- Saved Profiles Section -->
                                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="{StaticResource CornerRadiusNormal}" Padding="12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Profile đã lưu" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                                                <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding SaveCurrentProfileCommand}" ToolTip="Lưu profile hiện tại" Padding="6" HorizontalAlignment="Right">
                                                    <TextBlock Text="💾"/>
                                                </Button>
                                            </Grid>
                                            <ComboBox ItemsSource="{Binding SavedProfiles}" SelectedItem="{Binding SelectedSavedProfile, Mode=TwoWay}" Style="{StaticResource ModernComboBox}" MinHeight="36" DisplayMemberPath="Name"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Console" Style="{StaticResource ModernTabItem}">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Console Log" FontSize="{StaticResource FontSizeMedium}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox Content="Tự cuộn" IsChecked="{Binding AutoScrollLog, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding ClearLogCommand}" ToolTip="Xóa log" Padding="6">
                                            <TextBlock Text="🗑" FontSize="11"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding ExportLogCommand}" ToolTip="Xuất log" Padding="6" Margin="4,0,0,0">
                                            <TextBlock Text="💾" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Padding="0,0,4,4">
                                    <ItemsControl ItemsSource="{Binding LogEntries}" VirtualizingPanel.IsVirtualizing="True">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,1" Padding="6,2" Background="{Binding Level, Converter={StaticResource LogLevelToBackgroundConverter}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding FormattedTime}" FontFamily="{StaticResource MonospaceFont}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" Margin="8,0" Width="60"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="{StaticResource MonospaceFont}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ProgressBar Grid.Row="2" Height="3" Value="{Binding OverallProgress}" Maximum="100" Style="{StaticResource ModernProgressBar}" Margin="0,0,0,4" Foreground="{StaticResource PrimaryBrush}"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== STATUS BAR ==================== -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Mục: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                    <TextBlock Text="{Binding TotalItems}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                    <TextBlock Text=" | Đã chọn: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                    <TextBlock Text="{Binding SelectedItems}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                    <TextBlock Text=" | Dung lượng: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                    <TextBlock Text="{Binding TotalSelectedSize, Converter={StaticResource BytesToStringConverter}}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" FontSize="{StaticResource FontSizeSmall}" FontFamily="{StaticResource MonospaceFont}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding ScanProgressText}" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="User: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                    <TextBlock Text="{Binding SystemInfo.CurrentUser}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                    <TextBlock Text=" | " Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                    <TextBlock Text="{Binding SystemInfo.IsAdmin, Converter={StaticResource BoolToAdminTextConverter}}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}"/>
                    <TextBlock Text=" | " Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding SystemInfo.DotNetVersion}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextDisabledBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>