@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="app-shell">
    <header class="topbar">
        <a class="brand" href="." aria-label="WinCleaner Inspector home">
            <img class="brand-mark" src="assets/wincleaner.png" alt="" />
            <span>
                <strong>WinCleaner Inspector</strong>
                <small>Winapp2 database inspector</small>
            </span>
        </a>
        <div class="privacy-note"><span></span>Your files never leave this browser</div>
        <a class="github-link" href="https://github.com/minhtuancn/WinCleaner" target="_blank" rel="noreferrer">GitHub ↗</a>
    </header>

    <main>
        <section class="project-strip" aria-label="About WinCleaner">
            <div class="project-copy">
                <small>ABOUT WINCLEANER</small>
                <strong>WinCleaner</strong>
                <span>A free Windows cleaner powered by Winapp2. Inspector opens the same database locally, explains its rules, compares releases and exports selected cleaners for review.</span>
            </div>
            <div class="project-actions">
                <div class="action-group">
                    <span>GET WINCLEANER</span>
                    <nav aria-label="Download WinCleaner">
                        <a class="button download-button" href="https://github.com/minhtuancn/WinCleaner/releases/latest/download/WinCleaner-Classic.zip">Download Classic</a>
                        <a class="button download-button" href="https://github.com/minhtuancn/WinCleaner/releases/latest/download/WinCleaner-Modern.zip">Download Modern</a>
                    </nav>
                </div>
                <div class="action-group support-group">
                    <span>SUPPORT THE PROJECT</span>
                    <nav aria-label="Support WinCleaner development">
                        <a class="button paypal-button" href="https://www.paypal.com/donate/?hosted_button_id=YOUR_BUTTON_ID" target="_blank" rel="noreferrer">Donate with PayPal</a>
                        <a class="button kofi-button" href="https://ko-fi.com/yourname" target="_blank" rel="noreferrer">Support on Ko-fi</a>
                    </nav>
                </div>
            </div>
        </section>

        @if (VersionCheckRequested)
        {
            <section class="version-banner @(VersionUpdateAvailable ? "update" : VersionCheckUnavailable ? "unavailable" : "current")" aria-live="polite">
                <span class="version-symbol" aria-hidden="true">@(VersionUpdateAvailable ? "↑" : VersionCheckUnavailable ? "!" : "✓")</span>
                <div>
                    <strong>@EditionName @InstalledVersion</strong>
                    <span>@VersionStatusText</span>
                </div>
                <a class="button version-action" href="@VersionDownloadUrl">
                    @(VersionUpdateAvailable ? $"Download {LatestVersion}" : VersionCheckUnavailable ? "Open releases" : "Latest release")
                </a>
            </section>
        }

        <section class="import-grid" aria-label="Import files">
            <div class="drop-card primary @(Primary is null ? "empty" : "loaded")">
                <div class="drop-icon" aria-hidden="true">{ }</div>
                <div class="drop-copy">
                    <strong>@(Primary?.FileName ?? "Open Winapp2.ini")</strong>
                    <span>@(Primary is null ? "Drop or choose the database you want to inspect" : $"{Primary.Entries.Count:N0} valid entries loaded")</span>
                </div>
                <label class="button primary-button" for="primary-file">@(Primary is null ? "Choose file" : "Replace")</label>
                <InputFile id="primary-file" class="native-file" OnChange="LoadPrimaryAsync" accept=".ini,.txt" />
            </div>

            <div class="drop-card @(SettingsLoaded ? "loaded" : "")">
                <div class="drop-icon settings-icon" aria-hidden="true">✓</div>
                <div class="drop-copy">
                    <strong>@(SettingsLoaded ? SettingsFileName : "Add settings.json")</strong>
                    <span>@(SettingsLoaded ? $"{SavedSelection.Count:N0} saved cleaner selections" : "Optional · check saved entries against this database")</span>
                </div>
                <label class="button secondary-button" for="settings-file">@(SettingsLoaded ? "Replace" : "Choose")</label>
                <InputFile id="settings-file" class="native-file" OnChange="LoadSettingsAsync" accept=".json" />
            </div>

            <div class="drop-card @(Comparison is null ? "" : "loaded")">
                <div class="drop-icon compare-icon" aria-hidden="true">⇄</div>
                <div class="drop-copy">
                    <strong>@(Comparison?.FileName ?? "Compare another database")</strong>
                    <span>@(Comparison is null ? "Optional · see what was added or removed" : $"{AddedNames.Count:N0} added · {RemovedNames.Count:N0} removed")</span>
                </div>
                <label class="button secondary-button" for="compare-file">@(Comparison is null ? "Choose" : "Replace")</label>
                <InputFile id="compare-file" class="native-file" OnChange="LoadComparisonAsync" accept=".ini,.txt" />
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="message error" role="alert">@ErrorMessage</div>
        }

        @if (Primary is null)
        {
            <section class="empty-workspace">
                <div class="rule-art" aria-hidden="true">
                    <span>[Browser Cache]</span>
                    <span>Section=Google Chrome</span>
                    <span>FileKey1=%LocalAppData%\...|*|RECURSE</span>
                </div>
                <div>
                    <p class="eyebrow">READY</p>
                    <h1>Open a Winapp2 database to begin.</h1>
                    <p>The Inspector lists its cleaner entries, rules and warnings. You can also load a settings.json file or compare a second database. All processing stays on this PC.</p>
                </div>
            </section>
        }
        else
        {
            <section class="stats" aria-label="Database summary">
                <article><span>Cleaner entries</span><strong>@Primary.Entries.Count.ToString("N0")</strong><small>@Primary.IgnoredBlocks ignored blocks</small></article>
                <article><span>File rules</span><strong>@Primary.FileRules.ToString("N0")</strong><small>@Primary.RecursiveRules.ToString("N0") recursive</small></article>
                <article><span>Registry rules</span><strong>@Primary.RegistryRules.ToString("N0")</strong><small>@Primary.WholeRegistryKeys.ToString("N0") whole keys</small></article>
                <article><span>Warnings</span><strong>@Primary.WarningCount.ToString("N0")</strong><small>@Primary.DuplicateNames.Count.ToString("N0") duplicate names</small></article>
                @if (SettingsLoaded)
                {
                    <article class="accent-stat"><span>Saved selections</span><strong>@SavedMatches.ToString("N0")</strong><small>@MissingSavedNames.Count.ToString("N0") no longer found</small></article>
                }
            </section>

            @if (Comparison is not null || MissingSavedNames.Count > 0 || Primary.DuplicateNames.Count > 0)
            {
                <section class="findings" aria-label="Inspector findings">
                    @if (Comparison is not null)
                    {
                        <button class="finding" @onclick='() => ApplyFilter("added")'>
                            <strong>+@AddedNames.Count.ToString("N0")</strong><span>added in @Comparison.FileName</span>
                        </button>
                        <button class="finding" @onclick='() => ApplyFilter("removed")'>
                            <strong>−@RemovedNames.Count.ToString("N0")</strong><span>removed from @Primary.FileName</span>
                        </button>
                    }
                    @if (MissingSavedNames.Count > 0)
                    {
                        <button class="finding warning" @onclick='() => ApplyFilter("missing")'>
                            <strong>@MissingSavedNames.Count.ToString("N0")</strong><span>saved selections are missing</span>
                        </button>
                    }
                    @if (Primary.DuplicateNames.Count > 0)
                    {
                        <button class="finding warning" @onclick='() => ApplyFilter("duplicates")'>
                            <strong>@Primary.DuplicateNames.Count.ToString("N0")</strong><span>duplicate cleaner names</span>
                        </button>
                    }
                </section>
            }

            <section class="workspace">
                <div class="list-panel">
                    <div class="toolbar">
                        <label class="search-box">
                            <span aria-hidden="true">⌕</span>
                            <input type="search" placeholder="Search names, sections or paths" @bind="SearchText" @bind:event="oninput" />
                        </label>
                        <select aria-label="Filter cleaner entries" @bind="ActiveFilter">
                            <option value="all">All entries</option>
                            <option value="selected">Selected for handoff</option>
                            <option value="saved">Saved in settings</option>
                            <option value="warnings">Warnings</option>
                            <option value="defaults">Enabled by default</option>
                            <option value="duplicates">Duplicate names</option>
                            @if (Comparison is not null)
                            {
                                <option value="added">Added in comparison</option>
                                <option value="removed">Removed in comparison</option>
                            }
                        </select>
                        <button class="button primary-button toolbar-export" disabled="@(SelectedNames.Count == 0)" @onclick="ExportHandoffAsync">
                            Export selection (@SelectedNames.Count.ToString("N0"))
                        </button>
                    </div>

                    <div class="selection-bar">
                        <span><strong>@FilteredEntries.Count.ToString("N0")</strong> matching entries</span>
                        <span class="selection-actions">
                            <button @onclick="SelectVisible">Select page</button>
                            <button @onclick="ClearSelection">Clear selection</button>
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(HandoffMessage))
                    {
                        <div class="handoff-status" role="status">@HandoffMessage</div>
                    }

                    <div class="entry-list" role="list">
                        @foreach (var entry in PageEntries)
                        {
                            <article class="entry-row @(ReferenceEquals(DetailEntry, entry) ? "active" : "")" role="listitem" @onclick="() => DetailEntry = entry">
                                <label class="check" @onclick:stopPropagation="true">
                                    <input type="checkbox" checked="@SelectedNames.Contains(entry.Name)" @onchange="args => ToggleSelection(entry.Name, args)" aria-label="Select @entry.Name for handoff" />
                                    <span></span>
                                </label>
                                <div class="entry-main">
                                    <strong>@entry.Name</strong>
                                    <small>@DisplaySection(entry)</small>
                                </div>
                                <div class="badges">
                                    @if (entry.Default)
                                    {
                                        <span class="badge default">default</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(entry.Warning))
                                    {
                                        <span class="badge warn">warning</span>
                                    }
                                    @if (Primary.DuplicateNames.Contains(entry.Name))
                                    {
                                        <span class="badge duplicate">duplicate</span>
                                    }
                                </div>
                                <span class="rule-count">@(entry.FileKeys.Count + entry.RegKeys.Count) rules</span>
                                <span class="chevron" aria-hidden="true">›</span>
                            </article>
                        }

                        @if (PageEntries.Count == 0)
                        {
                            <div class="no-results">No entries match this view.</div>
                        }
                    </div>

                    @if (TotalPages > 1)
                    {
                        <nav class="pagination" aria-label="Entry pages">
                            <button disabled="@(CurrentPage == 1)" @onclick="PreviousPage">← Previous</button>
                            <span>Page @CurrentPage of @TotalPages</span>
                            <button disabled="@(CurrentPage == TotalPages)" @onclick="NextPage">Next →</button>
                        </nav>
                    }
                </div>

                <aside class="detail-panel" aria-label="Selected rule details">
                    @if (DetailEntry is null)
                    {
                        <div class="detail-empty">
                            <span aria-hidden="true">{ }</span>
                            <strong>Select an entry</strong>
                            <p>Its original rule block and impact will appear here.</p>
                        </div>
                    }
                    else
                    {
                        <div class="detail-heading">
                            <div>
                                <p class="eyebrow">@DisplaySection(DetailEntry)</p>
                                <h2>@DetailEntry.Name</h2>
                            </div>
                            <label class="detail-toggle">
                                <input type="checkbox" checked="@SelectedNames.Contains(DetailEntry.Name)" @onchange="args => ToggleSelection(DetailEntry.Name, args)" />
                                <span>@(SelectedNames.Contains(DetailEntry.Name) ? "Included" : "Include")</span>
                            </label>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(DetailEntry.Warning))
                        {
                            <div class="message warning"><strong>Database warning</strong>@DetailEntry.Warning</div>
                        }

                        <div class="detail-metrics">
                            <span><strong>@DetailEntry.FileKeys.Count</strong> file rules</span>
                            <span><strong>@DetailEntry.RegKeys.Count</strong> registry rules</span>
                            <span><strong>@DetailEntry.ExcludeKeys.Count</strong> exclusions</span>
                        </div>

                        <div class="source-header"><span>Original source</span><button @onclick="CopySourceAsync">Copy</button></div>
                        <pre>@DetailEntry.RawText</pre>
                    }
                </aside>
            </section>

        }
    </main>

    <footer>
        <span>FluentCleaner Inspector · local-first and open source</span>
        <span>Nothing is uploaded. Nothing is cleaned.</span>
    </footer>
</div>
