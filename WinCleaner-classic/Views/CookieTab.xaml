<UserControl x:Class="WinCleaner.Views.CookieTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:design="clr-namespace:WinCleaner.Design"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800"
             Background="{DynamicResource BackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="{DynamicResource CardPadding}">
                <Path Data="{x:Static design:Icons.Browser}" Fill="{DynamicResource PrimaryBrush}" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Cookie Cleaner" FontSize="{DynamicResource FontSizeXLarge}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Scan and clean browser cookies" FontSize="{DynamicResource FontSizeNormal}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}">
            <Grid Margin="{DynamicResource CardPadding}">
                <TextBlock Text="Cookie Cleaner functionality will be implemented here."
                           FontSize="{DynamicResource FontSizeLarge}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>