<Window x:Class="WinCleaner.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pick Accent Color"
        Width="420"
        Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WinCleaner;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Color Preview and Hex Input -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="60" Height="60" CornerRadius="8" Margin="0,0,16,0">
                    <Border.Background>
                        <SolidColorBrush x:Name="ColorPreview" Color="#0078D4"/>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Hex Color" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="HexTextBox" 
                             Text="#0078D4"
                             FontFamily="{DynamicResource MonospaceFont}"
                             FontSize="16"
                             Padding="12,8"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextChanged="OnHexTextChanged"/>
                </StackPanel>
            </Grid>

            <!-- Hue Slider -->
            <Border Grid.Row="1" Margin="0,0,0,12" Height="160">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Hue" FontSize="14" FontWeight="Medium" 
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Width="50"/>

                    <Grid Grid.Column="1">
                        <Canvas x:Name="HueCanvas" Height="160" Background="Transparent">
                            <Canvas.Resources>
                                <LinearGradientBrush x:Key="HueGradient" StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF0000" Offset="0.000"/>
                                    <GradientStop Color="#FFFF00" Offset="0.167"/>
                                    <GradientStop Color="#00FF00" Offset="0.333"/>
                                    <GradientStop Color="#00FFFF" Offset="0.500"/>
                                    <GradientStop Color="#0000FF" Offset="0.667"/>
                                    <GradientStop Color="#FF00FF" Offset="0.833"/>
                                    <GradientStop Color="#FF0000" Offset="1.000"/>
                                </LinearGradientBrush>
                            </Canvas.Resources>
                            <Rectangle Width="24" Height="160" Fill="{StaticResource HueGradient}" RadiusX="4" RadiusY="4"/>
                            <Border x:Name="HueMarker" Width="32" Height="4" Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>
                        </Canvas>
                        <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Value="210" 
                                Margin="12,0,0,0" VerticalAlignment="Center" Height="160"
                                Background="Transparent" Foreground="{DynamicResource PrimaryBrush}"
                                ValueChanged="OnHueChanged"
                                MouseLeftButtonDown="OnHueMouseDown"
                                MouseMove="OnHueMouseMove"
                                MouseLeftButtonUp="OnHueMouseUp"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Saturation/Value Picker and Sliders -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Saturation/Value Canvas -->
                <Border Grid.Column="0" Margin="0,0,16,0">
                    <Canvas x:Name="SaturationValueCanvas" Background="Transparent" 
                            MouseLeftButtonDown="OnSaturationValueMouseDown"
                            MouseMove="OnSaturationValueMouseMove"
                            MouseLeftButtonUp="OnSaturationValueMouseUp">
                        <Rectangle x:Name="SaturationValueRect" Width="240" Height="240" RadiusX="4" RadiusY="4">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White" Offset="0"/>
                                    <GradientStop x:Name="HueColorStop" Color="#FF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Width="240" Height="240" RadiusX="4" RadiusY="4">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="Black" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Ellipse x:Name="PickerEllipse" Width="16" Height="16" 
                                 Fill="White" Stroke="Black" StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Border>

                <!-- Saturation and Value Sliders -->
                <StackPanel Grid.Column="1" Width="120" VerticalAlignment="Center">
                    <TextBlock Text="Saturation" FontSize="14" FontWeight="Medium" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <Slider x:Name="SaturationSlider" Minimum="0" Maximum="100" Value="100"
                            Orientation="Vertical" Height="200"
                            Background="Transparent" Foreground="{DynamicResource PrimaryBrush}"
                            ValueChanged="OnSaturationChanged"/>

                    <TextBlock Text="Brightness" FontSize="14" FontWeight="Medium" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,24,0,8"/>
                    <Slider x:Name="ValueSlider" Minimum="0" Maximum="100" Value="100"
                            Orientation="Vertical" Height="200"
                            Background="Transparent" Foreground="{DynamicResource PrimaryBrush}"
                            ValueChanged="OnValueChanged"/>
                </StackPanel>
            </Grid>

            <!-- OK/Cancel Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{DynamicResource GhostButtonStyle}" 
                        Padding="24,10" Margin="0,0,8,0" Click="OnCancelClick"/>
                <Button Content="OK" Style="{DynamicResource PrimaryButtonStyle}" 
                        Padding="24,10" Click="OnOkClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>